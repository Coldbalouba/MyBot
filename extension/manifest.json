{
  "manifest_version": 3,
  "name": "AI Browser Bridge",
  "version": "1.1.0",
  "description": "Bridges your Chrome browser to the AI Browser dock app via WebSocket.",
  "permissions": [
    "tabs",
    "scripting",
    "alarms",
    "windows"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["keepalive.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Browser Bridge"
  }
}
